# ===================================================
# Tico - TicTac Agency Performance
# Configuración de Variables de Entorno
# ===================================================

# Configuración del Servidor Backend (Node.js)
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api

# Motor de IA para Generación de Estrategias y Copys
# Opciones soportadas: OpenAI, Google Gemini, Anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------
# Integración con Meta Ads (Facebook & Instagram)
# Graph API v21.0+
# ---------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Token de acceso de usuario del sistema (System User Token) con permisos:
# ads_management, ads_read, business_management
META_ACCESS_TOKEN=your_long_lived_system_user_token
META_AD_ACCOUNT_ID=act_your_ad_account_id

# ---------------------------------------------------
# Integración con Google Ads API
# Google Ads REST / gRPC API v18+
# ---------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_oauth2_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth2_refresh_token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=987-654-3210 # MCC Manager Account (si aplica)
